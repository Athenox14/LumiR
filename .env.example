# PipouFlix Environment Variables

# Session secret for nuxt-auth-utils (min 32 characters) - CHANGE IN PRODUCTION
NUXT_SESSION_PASSWORD=your-super-secret-session-password-min-32-chars

# Consumet API Base URL (self-hosted instance, no API key needed)
# CONSUMET_BASE_URL=http://localhost:3001

# Database path (optional, defaults to ./data/pipouflix.db)
DATABASE_PATH=./data/pipouflix.db
