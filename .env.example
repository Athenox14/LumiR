# LumiR environment variables

# Session secret for nuxt-auth-utils (minimum 32 characters)
NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret

# Optional database path
DATABASE_PATH=./data/lumir.db

# Optional TMDB API key for metadata enrichment
# TMDB_API_KEY=your_tmdb_api_key

# Optional external plugins directory
# LUMIR_PLUGINS_DIR=../lumir-plugins
